# Application Configuration
APP_NAME=rigel-ledger
# APP_VERSION overrides the version baked in at build time; normally leave unset.
APP_ENV=development
APP_URL=localhost
APP_PORT=8080
LOG_LEVEL=debug
# Sliding login lifetime.
SESSION_TTL=720h

# Database: either DATABASE_URL, or the PG_* parts below.
# DATABASE_URL=postgres://rigel:secret@10.0.1.1:5432/rigelledger?sslmode=disable
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=changeme
APP_DBNAME=rigelledger
PG_MAX_CONNS=10

# Tests: a server where the tests may CREATE and DROP throwaway databases.
# Without it the DB tests skip.
TEST_DATABASE_URL=postgres://postgres:changeme@localhost:5432/postgres?sslmode=disable
