# Application Configuration
APP_NAME=rigel-ledger
# APP_VERSION overrides the version baked in at build time; normally leave unset.
APP_ENV=development
APP_URL=localhost
APP_PORT=8080
LOG_LEVEL=debug
# Sliding login lifetime.
SESSION_TTL=720h

# Database: either DATABASE_URL, or the PG_* parts below.
# DATABASE_URL=postgres://rigel:secret@10.0.1.1:5432/rigelledger?sslmode=disable
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASS=changeme
APP_DBNAME=rigelledger
PG_MAX_CONNS=10

# Tests: a server where the tests may CREATE and DROP throwaway databases.
# Without it the DB tests skip.
TEST_DATABASE_URL=postgres://postgres:changeme@localhost:5432/postgres?sslmode=disable

# Public base URL for links in mail. Empty in development: http://localhost:<APP_PORT>.
# APP_ORIGIN=https://ledger.example.com
# Seals the SMTP password stored in the database. Required in production:
#   openssl rand -base64 32
# APP_ENCRYPTION_KEY=
# Hops whose X-Forwarded-For is believed (the pod network, loopback).
# TRUSTED_PROXIES=10.42.0.0/16,127.0.0.1/32,::1/128

# First administrator, created only while none exists. The first sign-in asks
# for a new password and walks the setup wizard.
# ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
# ADMIN_EMAIL=

# Mail: copied into the system settings on the first start only; afterwards the
# Administration page owns them. "log" prints each message (links, codes).
MAIL_DRIVER=log
# SMTP_HOST=smtp.purelymail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ledger@example.com
# MAIL_FROM_NAME=RigelLedger
