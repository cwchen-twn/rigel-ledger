{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug RigelLedger",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/rigelledger/main.go",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "GO_ENV": "development"
            },
            "args": [],
            "showLog": true,
            "console": "integratedTerminal"
        },
        {
            "name": "Attach to Air",
            "type": "go",
            "mode": "remote",
            "request": "attach",
            "host": "127.0.0.1",
            "port": 2345
        }
    ]
}
