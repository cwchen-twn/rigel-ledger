{
  "name": "rigel-sync",
  "private": true,
  "type": "module",
  "description": "A person's sync runner for every institution RigelLedger syncs, linked to RigelLedger under Settings -> Sync runner",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "rigel-sync": "src/main.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.ts'",
    "vendor:check": "bun scripts/vendor.ts --check",
    "check": "bun run typecheck && bun run vendor:check && bun run test"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "22.18.0",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "imapflow": "2.2.6",
    "jpeg-js": "0.4.4",
    "mailparser": "3.9.36",
    "node-forge": "1.4.0",
    "onnxruntime-web": "1.30.0",
    "pdfjs-dist": "6.4.299",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.12.0",
    "zod": "4.6.5"
  }
}
