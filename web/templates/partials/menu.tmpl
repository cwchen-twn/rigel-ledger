{{define "protected:menu"}}
<div x-data="{
    isLargeScreen: false,
    init() {
        // Initialize screen size state without causing flash
        this.isLargeScreen = window.innerWidth >= 768;

        // Update display state on window resize
        window.addEventListener('resize', () => {
            this.isLargeScreen = window.innerWidth >= 768;
        });
    }
}">
    <!-- Mobile/Tablet Offcanvas Toggle Button -->
    <button
        class="btn btn-secondary d-md-none"
        type="button"
        data-bs-toggle="offcanvas"
        data-bs-target="#sidebarOffcanvas"
        aria-controls="sidebarOffcanvas"
        aria-label="Toggle sidebar"
    >
        <i class="bi bi-layout-sidebar-inset"></i>
    </button>

    <!-- Desktop Sidebar (visible on md+ screens) -->
    <div
        class="d-none d-md-flex flex-column flex-shrink-0 justify-content-between min-vh-100 p-3"
        x-show="isLargeScreen"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 transform -translate-x-4"
        x-transition:enter-end="opacity-100 transform translate-x-0"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 transform translate-x-0"
        x-transition:leave-end="opacity-0 transform -translate-x-4"
    >
        {{template "menu-content" .}}
    </div>

    <!-- Mobile/Tablet Offcanvas -->
    <div
        class="offcanvas offcanvas-start d-md-none"
        tabindex="-1"
        id="sidebarOffcanvas"
        aria-labelledby="sidebarOffcanvasLabel"
        data-bs-backdrop="true"
        data-bs-scroll="true"
    >
        <div class="offcanvas-header flex-row-reverse">
            <button
                type="button"
                class="btn btn-secondary"
                data-bs-dismiss="offcanvas"
                aria-label="Close"
            ><i class="bi bi-layout-sidebar-inset"></i></button>
        </div>
        <div class="offcanvas-body">
            {{template "menu-content" .}}
        </div>
    </div>
</div>
{{end}}

{{define "menu-content"}}
<div>
    <div class="d-flex justify-content-center align-items-center flex-wrap gap-2">
        <img
            class="img-thumbnail rounded-circle"
            width="48"
            height="48"
            src="/static/favicon-32x32.png"
            alt="Rigel Ledger"
        >
        <h1 class="fs-5 mb-0">Rigel Ledger</h1>
    </div>
    <hr>
    <ul class="nav nav-pills flex-column fs-5 fw-bold">
        <li class="nav-item">
            {{ $activated := "" }}
            {{ if eq .Page "home" }}
                {{ $activated = "active" }}
            {{ end }}
            <a href="/{{.Username}}" class="nav-link {{ $activated }}" ><i class="bi bi-house-door"></i> Home</a>
        </li>
        <li class="nav-item">
            {{ $activated := "" }}
            {{ if eq .Page "ledgers" }}
                {{ $activated = "active" }}
            {{ end }}
            <a href="/{{.Username}}/ledgers" class="nav-link {{ $activated }}" ><i class="bi bi-journal-bookmark"></i> Ledgers</a>
        </li>
        <li class="nav-item">
            {{ $activated := "" }}
            {{ if eq .Page "reports" }}
                {{ $activated = "active" }}
            {{ end }}
            <a href="/{{.Username}}/reports" class="nav-link {{ $activated }}" ><i class="bi bi-clipboard-data"></i> Reports</a>
        </li>
    </ul>
</div>
<div>
    <ul class="nav nav-pills fs-5 fw-bold">
        <li class="nav-item">
            <a href="/logout" class="nav-link">Logout</a>
        </li>
    </ul>
    <hr>
    <footer class="text-center">
        <p class="fs-6 text-muted mb-1">
            RigelLedger Web, Version: {{.Version}}
        </p>
        <p class="fs-6 text-muted">
            Copyright &copy; {{now | formatTime "2006"}} Catopia de Chen Antúnez E.A.S. Paraguay
        </p>
    </footer>
</div>
{{end}}
