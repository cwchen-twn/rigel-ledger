{{define "protected:base"}}
    {{template "public:base" .}}
{{end}}

{{define "scripts"}}{{end}}

{{define "main"}}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Column -->
        <div class="col-12 col-md-2">
            {{template "protected:menu" .}}
        </div>
        <!-- Main Content Column -->
        <div class="col-12 col-md-10 mt-5 mt-md-0 p-3 p-md-4">
            {{template "protected:main" .}}
        </div>
    </div>
</div>
{{end}}
