{{define "protected:base"}}
    {{template "public:base" .}}
{{end}}

{{define "scripts"}}
    {{template "protected:scripts" .}}
    <script type="text/javascript" nonce="{{.Nonce}}">
        // Auto logout and token refresh functionality
        (function() {
            'use strict';

            const ACCESS_TOKEN_LIFETIME = parseInt("{{ formatFloat .AccessTokenLeftTime 0 }}");

            // Configuration
            const CONFIG = {
                ACCESS_TOKEN_UNTIL: dayjs().add(ACCESS_TOKEN_LIFETIME, 's'),
                // Check interval (every 1 minute)
                CHECK_INTERVAL_SEC: 1 * 60,
                // Refresh token when access token has 2 minutes left
                REFRESH_THRESHOLD: 2 * 60, // 2 minutes
                // Activity timeout, since the access token is refreshed every 13 minutes
                ACTIVITY_TIMEOUT_SEC: 5 * 60, // 5 minutes
            };

            let lastTokenRefresh = dayjs();
            let lastActivity = dayjs();
            let refreshInterval = null;
            let activityTimeout = null;
            let isRefreshing = false;

            // Track user activity
            function updateActivity() {
                lastActivity = dayjs();
            }

            // Add event listeners for user activity
            function setupActivityTracking() {
                const events = ['mousedown', 'mousemove', 'keypress', 'scroll', 'touchstart', 'click'];
                events.forEach(event => {
                    document.addEventListener(event, updateActivity, true);
                });
            }

            // Check if access token is about to expire
            function isAccessTokenExpiringSoon() {
                // Since we can't decode JWT on client side, we'll refresh every 13 minutes
                // (15 min lifetime - 2 min threshold = 13 min)
                const secondsSinceLastRefresh = dayjs().diff(lastTokenRefresh, 's');
                const until = CONFIG.ACCESS_TOKEN_UNTIL.subtract(CONFIG.REFRESH_THRESHOLD, 's');
                const threshold = until.diff(dayjs(), 's');
                return secondsSinceLastRefresh >= threshold;
            }

            // Check if user has been inactive too long
            function isUserInactive() {
                const secondsSinceLastActivity = dayjs().diff(lastActivity, 's');
                return secondsSinceLastActivity >= CONFIG.ACTIVITY_TIMEOUT_SEC;
            }

            // Refresh access token
            async function refreshAccessToken() {
                if (isRefreshing) {
                    return false;
                }

                isRefreshing = true;

                try {
                    const response = await fetch('/refresh-token', {
                        method: 'POST',
                    });

                    if (response.ok) {
                        const data = await response.json();
                        CONFIG.ACCESS_TOKEN_UNTIL = dayjs().add(data.access_token_left_time, 's');
                        lastTokenRefresh = dayjs();
                        console.log('Tokens refreshed successfully');
                        return true;
                    } else if (response.status === 401) {
                        // Refresh token is invalid, logout
                        console.log('Refresh token expired, logging out');
                        logout();
                        return false;
                    }
                } catch (error) {
                    console.error('Error refreshing token:', error);
                } finally {
                    isRefreshing = false;
                }

                return false;
            }

            // Logout user
            function logout() {
                // Clear intervals
                if (refreshInterval) {
                    clearInterval(refreshInterval);
                }
                if (activityTimeout) {
                    clearInterval(activityTimeout);
                }

                // Redirect to login page
                window.location.href = '/logout';
            }

            // Main check function
            function checkTokenAndActivity() {
                // Check if user has been inactive
                if (isUserInactive()) {
                    console.log('User inactive for too long, logging out');
                    logout();
                    return;
                }

                // Check if access token needs refresh
                if (isAccessTokenExpiringSoon()) {
                    console.log('Access token expiring soon, refreshing...');
                    refreshAccessToken();
                }
            }

            // Initialize auto logout system
            function initAutoLogout() {
                // Set up activity tracking
                setupActivityTracking();

                // Start checking interval
                refreshInterval = setInterval(checkTokenAndActivity, CONFIG.CHECK_INTERVAL_SEC * 1000);

                // Set up activity timeout interval
                activityTimeout = setInterval(() => {
                    if (isUserInactive()) {
                        logout();
                    }
                }, CONFIG.ACTIVITY_TIMEOUT_SEC * 1000);

                console.log('Auto logout system initialized');
            }

            // Start the system when DOM is ready
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initAutoLogout);
            } else {
                initAutoLogout();
            }

            // Handle page visibility changes
            document.addEventListener('visibilitychange', function() {
                if (document.hidden) {
                    // Page is hidden, pause some checks
                    console.log('Page hidden, pausing some checks');
                } else {
                    // Page is visible, resume checks and update activity
                    updateActivity();
                    console.log('Page visible, resuming checks');
                }
            });

            // Handle beforeunload to clean up
            window.addEventListener('beforeunload', function() {
                if (refreshInterval) {
                    clearInterval(refreshInterval);
                }
                if (activityTimeout) {
                    clearInterval(activityTimeout);
                }
            });

        })();
    </script>
{{end}}

{{define "main"}}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar Column -->
        <div class="col-12 col-md-2">
            {{template "protected:menu" .}}
        </div>
        <!-- Main Content Column -->
        <div class="col-12 col-md-10 p-3 p-md-4">
            {{template "protected:main" .}}
        </div>
    </div>
</div>
{{end}}
