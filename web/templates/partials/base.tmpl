{{define "public:base"}}
<!doctype html>
<html lang="{{.Lang}}" data-theme="{{.Theme}}">
    <head>
        <title>{{block "title" .}}RigelLedger{{end}}</title>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <link rel="icon" type="image/x-icon" href="/static/favicon.ico?version={{.Version}}">
        <script nonce="{{.Nonce}}">
// Resolve the theme before first paint so a dark-mode user never sees a white flash.
(function () {
  var t = document.documentElement.dataset.theme;
  var dark = t === "dark" || (t === "system" && window.matchMedia("(prefers-color-scheme: dark)").matches);
  document.documentElement.classList.toggle("dark", dark);
})();
window.__APP_CONFIG__ = { version: "{{.Version}}" };
        </script>
        <link rel="stylesheet" href="/static/dist/main.css?version={{.Version}}">
        <script src="/static/dist/main.js?version={{.Version}}" defer nonce="{{.Nonce}}"></script>
        {{block "head" .}}{{end}}
    </head>
    <body>
        {{block "main" .}}{{end}}
    </body>
</html>
{{end}}
