{{define "public:base"}}
<!doctype html>
<html lang='en' data-bs-theme="{{.ColorScheme}}">
    <head>
        <title>{{block "title" .}}Rigelledger{{end}}</title>
        <meta charset='utf-8'>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <meta name="author" content="cwchen.twn">
        {{block "meta" .}}{{end}}

        <link rel="icon" type="image/x-icon" href="/static/favicon.ico?version={{.Version}}">
        <link rel="stylesheet" href="/static/dist/main.css?version={{.Version}}">
        <script nonce="{{.Nonce}}">
window.__APP_CONFIG__ = {
  username: "{{.Username}}",
  accessTokenLeftTime: {{formatFloat .AccessTokenLeftTime 0}}
};
        </script>
        <script src="/static/dist/main.js?version={{.Version}}" defer nonce="{{.Nonce}}"></script>
        {{block "scripts" .}}{{end}}
    </head>
    <body>
        {{block "main" .}}{{end}}
    </body>
</html>
{{end}}
