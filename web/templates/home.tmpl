{{define "home"}}
    {{template "protected:base" .}}
{{end}}

{{define "title"}}Rigelledger Home{{end}}

{{define "meta"}}
<meta name="description" content="Rigelledger Home Page">
{{end}}

{{define "protected:main"}}
<div class="row mb-3">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="btn-group mb-4" role="group" aria-label="Balance">
                    <input type="radio" class="btn-check" name="balancetype" id="assets" autocomplete="off" checked>
                    <label class="btn btn-sm btn-outline-secondary" for="assets">Assets</label>

                    <input type="radio" class="btn-check" name="balancetype" id="liabilities" autocomplete="off">
                    <label class="btn btn-sm btn-outline-secondary" for="liabilities">Liabilities</label>

                    <input type="radio" class="btn-check" name="balancetype" id="networth" autocomplete="off">
                    <label class="btn btn-sm btn-outline-secondary" for="networth">Net Assets</label>
                </div>
                <h5 class="card-title">Total Assets</h5>
                <p class="card-text fs-2">1,000,000 USD</p>
                <h6 class="card-subtitle mb-2 text-body-secondary">+20.1% from last month</h6>
                <h6 class="card-subtitle mb-2 text-body-secondary">+40.1% year to date</h6>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Assets Distribution</h5>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <div class="btn-group mb-4" role="group" aria-label="Balance Changes Over Time">
                    <input type="radio" class="btn-check" name="balanceintime" id="currentmonth" autocomplete="off" checked>
                    <label class="btn btn-sm btn-outline-secondary" for="currentmonth">Current Month</label>

                    <input type="radio" class="btn-check" name="balanceintime" id="30days" autocomplete="off">
                    <label class="btn btn-sm btn-outline-secondary" for="30days">30 Days</label>

                    <input type="radio" class="btn-check" name="balanceintime" id="ytd" autocomplete="off">
                    <label class="btn btn-sm btn-outline-secondary" for="ytd">Year to Date</label>
                </div>
                <h5 class="card-title">Balance Changes Over Time</h5>
            </div>
        </div>
    </div>
</div>
<div class="row mb-3">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <div class="btn-group mb-4" role="group" aria-label="Income Changes Over Time">
                    <input type="radio" class="btn-check" name="incomeintime" id="currentmonth-income" autocomplete="off" checked>
                    <label class="btn btn-sm btn-outline-secondary" for="currentmonth-income">Current Month</label>

                    <input type="radio" class="btn-check" name="incomeintime" id="30days-income" autocomplete="off">
                    <label class="btn btn-sm btn-outline-secondary" for="30days-income">30 Days</label>

                    <input type="radio" class="btn-check" name="incomeintime" id="ytd-income" autocomplete="off">
                    <label class="btn btn-sm btn-outline-secondary" for="ytd-income">Year to Date</label>
                </div>
                <h5 class="card-title">Income</h5>
                <p class="card-text fs-2">5,000 USD</p>
                <h6 class="card-subtitle mb-2 text-body-secondary">+0.% from last month</h6>
                <hr>
                <h5 class="card-title">Expenses</h5>
                <p class="card-text fs-2">2,000 USD</p>
                <h6 class="card-subtitle mb-2 text-body-secondary">+0.% from last month</h6>
                <hr>
                <h5 class="card-title">Net Income</h5>
                <p class="card-text fs-2">3,000 USD</p>
                <h6 class="card-subtitle mb-2 text-body-secondary">+0.% from last month</h6>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Top Income</h5>
                <hr>
                <h5 class="card-title">Top Expenses</h5>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Income/Expense Over Time</h5>
            </div>
        </div>
    </div>
</div>
<div class="row mb-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                Recent Transactions
            </div>
            <div class="card-body">
                <table class="table table-striped table-bordered" id="transactions-table">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Transaction Date</th>
                            <th>Description</th>
                            <th>Amount</th>
                            <th>Exchange Rate</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>
<nav class="navbar fixed-bottom col-12 col-md-10 offset-md-2 bg-body-tertiary">
    <div class="container-fluid d-flex justify-content-end">
        <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#new-transaction-modal"
        ><i class="bi bi-clipboard2-plus"></i> New Transaction</button>
    </div>
</nav>
<div
    class="modal fade"
    id="new-transaction-modal"
    tabindex="-1"
    aria-labelledby="new-transaction-modal-label"
    aria-hidden="true"
>
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">New Transaction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>New transaction form goes here.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>
{{end}}
