{{define "ledgers"}}
    {{template "protected:base" .}}
{{end}}

{{define "title"}}Rigelledger Ledgers{{end}}

{{define "meta"}}
<meta name="description" content="Rigelledger Ledgers Page">
{{end}}

{{define "protected:scripts"}}
<script type="text/javascript" nonce="{{.Nonce}}">
document.addEventListener('DOMContentLoaded', async function() {
    const table = new DataTable('#ledgers-table', {
        pageLength: 10,
        responsive: true,
        ajax: {
            url: '/{{.Username}}/api/ledgers',
            method: 'GET',
            accepts: 'application/json',
            timeout: 5000,
            error: function (jqXHR, textStatus, errorThrown) {
                const status = jqXHR.status;
                const responseText = jqXHR.responseText;
                console.log(jqXHR, textStatus, errorThrown, status, responseText);
            },
        },
        columns: [
            {
                title: 'Ledger Name',
                data: 'ledger_name',
            },
            {
                title: 'Ledger Type',
                data: function(row, type, set, meta) {
                    if (type === 'set') {
                        row.ledger_type = set;
                        return;
                    }
                    if (type === 'display') {
                        return row.ledger_type.type_name;
                    }
                    if (type === 'filter') {
                        return row.ledger_type.type_name;
                    }
                    return row.ledger_type;
                },
            },
            {
                title: 'Currency',
                data: 'currency',
            },
            {
                title: 'Balance',
                data: 'balance',
            },
            {
                title: 'Ledger Status',
                data: 'ledger_status',
            },
            {
                title: 'Created At',
                data: 'created_at',
            },
            {
                title: 'Updated At',
                data: 'updated_at',
            },
        ],
    });
});

const ledgerData = () => ({
    ledgerTypes: [
        {
            label: 'Select a ledger type',
            value: '',
        }
    ],
    currencies: [
        {
            label: 'Select a currency',
            value: '',
        }
    ],
    async init() {
        this.ledgerTypes = [...this.ledgerTypes, ...await fetch('/{{.Username}}/api/ledger-types').then(res => res.json())];
        this.currencies = [...this.currencies, ...await fetch('/{{.Username}}/api/currencies').then(res => res.json())];
    }
});
</script>
{{end}}

{{define "protected:main"}}
<div x-data="ledgerData()" x-init="init">
    <div class="card">
        <div class="card-header">
            {{ .Username }}'s Ledgers
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered" id="ledgers-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Ledger Name</th>
                        <th>Ledger Type</th>
                        <th>Currency</th>
                        <th>Balance</th>
                        <th>Ledger Status</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <nav class="navbar fixed-bottom col-12 col-md-10 offset-md-2 bg-body-tertiary">
        <div class="container-fluid d-flex justify-content-end">
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#new-ledger-modal"
            ><i class="bi bi-clipboard2-plus"></i> New Ledger</button>
        </div>
    </nav>
    <div
        class="modal fade"
        id="new-ledger-modal"
        tabindex="-1"
        aria-labelledby="new-ledger-modal-label"
        aria-hidden="true"
    >
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Ledger</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="new-ledger-form">
                        <div class="form-group">
                            <label for="ledger-name">Ledger Name</label>
                            <input type="text" class="form-control" id="ledger-name" name="ledger-name" required>
                        </div>
                        <div class="form-group">
                            <label for="ledger-type">Ledger Type</label>
                            <select class="form-control" id="ledger-type" name="ledger-type" required>
                                <option value="">Select a ledger type</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="currency">Currency</label>
                            <input type="text" class="form-control" id="currency" name="currency" required>
                        </div>
                        <div class="form-group">
                            <label for="balance">Balance</label>
                            <input type="number" class="form-control" id="balance" name="balance" required>
                        </div>
                        <div class="form-group">
                            <label for="ledger-status">Ledger Status</label>
                            <select class="form-control" id="ledger-status" name="ledger-status" required>
                                <option value="1">Active</option>
                                <option value="0">Inactive</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
