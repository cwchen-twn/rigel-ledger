{{define "ledgers"}}
    {{template "protected:base" .}}
{{end}}

{{define "title"}}Rigelledger Ledgers{{end}}

{{define "meta"}}
<meta name="description" content="Rigelledger Ledgers Page">
{{end}}

{{define "protected:scripts"}}
<script type="text/javascript" nonce="{{.Nonce}}">
let table = null;

document.addEventListener('DOMContentLoaded', async function() {
    table = new DataTable('#ledgers-table', {
        pageLength: 10,
        responsive: true,
        ajax: {
            dataSrc: "",
            url: '/{{.Username}}/api/ledgers',
            method: 'GET',
            accepts: 'application/json',
            timeout: 5000,
            error: function (jqXHR, textStatus, errorThrown) {
                const status = jqXHR.status;
                const responseText = jqXHR.responseText;
                console.log(jqXHR, textStatus, errorThrown, status, responseText);
            },
        },
        columns: [
            {
                title: 'Ledger Name',
                data: 'ledger_name',
            },
            {
                title: 'Ledger Type',
                data: function(row, type, set, meta) {
                    if (type === 'set') {
                        row.ledger_type = set;
                        return;
                    }
                    if (type === 'display') {
                        return row.ledger_type.type_name;
                    }
                    if (type === 'filter') {
                        return row.ledger_type.type_name;
                    }
                    return row.ledger_type;
                },
            },
            {
                title: 'Currency',
                data: 'currency',
            },
            {
                title: 'Balance',
                data: 'balance',
            },
            {
                title: 'Ledger Status',
                data: 'ledger_status',
            },
            {
                title: 'Created At',
                data: 'created_at',
            },
            {
                title: 'Updated At',
                data: 'updated_at',
            },
        ],
    });

    const modal = document.getElementById('new-ledger-modal');
    if (modal) {
        modal.addEventListener('hide.bs.modal', () => {
            // Ensure no element inside the modal retains focus when hidden
            const focusedElement = document.activeElement;
            if (focusedElement && modal.contains(focusedElement)) {
                focusedElement.blur();
            }
        });
    }
});

const ledgerData = () => ({
    ledgerName: '',
    ledgerTypeID: '',
    currency: '',
    balance: "0.00",

    validateField(element) {
        if (!element.checkValidity()) {
            element.classList.add('is-invalid');
            element.classList.remove('is-valid');
        } else {
            element.classList.add('is-valid');
            element.classList.remove('is-invalid');
        }
    },

    async save() {
        const formData = {
            ledgerName: this.ledgerName,
            ledgerTypeID: this.ledgerTypeID,
            currency: this.currency,
            balance: new bigDecimal(this.balance),
        };
        console.log(formData);

        // Validate the form
        const form = document.getElementById('new-ledger-form');
        if (!form.checkValidity()) {
            console.error('Form validation failed');
            form.querySelectorAll('[required]').forEach(element => {
                this.validateField(element);
            });
            return;
        }
        form.classList.add('was-validated');

        // Submit the form
        const response = await fetch('/{{.Username}}/api/ledgers', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify([formData]),
        });

        if (!response.ok) {
            const error = await response.text();
            console.error(error);
            return;
        }

        // Reload the table
        table.ajax.reload();

        // Properly handle modal closing with focus management
        const modal = document.getElementById('new-ledger-modal');
        if (modal) {
            // Hide the modal
            const bsModal = bootstrap.Modal.getInstance(modal);
            if (bsModal) {
                bsModal.hide();
            }
        }
    },
});
</script>
{{end}}


{{define "protected:main"}}
<div>
    <div class="card">
        <div class="card-header">
            {{ .Username }}'s Ledgers
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered" id="ledgers-table">
                <thead>
                    <tr>
                        <th>Ledger Name</th>
                        <th>Ledger Type</th>
                        <th>Currency</th>
                        <th>Balance</th>
                        <th>Ledger Status</th>
                        <th>Created At</th>
                        <th>Updated At</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <nav class="navbar fixed-bottom col-12 col-md-10 offset-md-2 bg-body-tertiary">
        <div class="container-fluid d-flex justify-content-end">
            <button
                type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#new-ledger-modal"
            ><i class="bi bi-clipboard2-plus"></i> New Ledger</button>
        </div>
    </nav>
    <div
        class="modal fade"
        id="new-ledger-modal"
        tabindex="-1"
        aria-labelledby="new-ledger-modal-label"
        x-data="ledgerData()"
    >
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">New Ledger</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="new-ledger-form" class="needs-validation" novalidate>
                        <div class="form-group">
                            <label for="ledger-name">Ledger Name</label>
                            <input
                                x-model="ledgerName"
                                type="text"
                                class="form-control"
                                id="ledger-name"
                                name="ledger-name"
                                autocomplete="off"
                                x-on:input="validateField($el)"
                                required
                            >
                            <div class="invalid-feedback">Please enter a ledger name</div>
                        </div>
                        {{template "searchable-select" (map
                            "ID" "ledgertype"
                            "Name" "ledger-type"
                            "Label" "Ledger Type"
                            "Placeholder" "Search a ledger type..."
                            "ApiUrl" (printf "/%s/api/ledger-types" .Username)
                            "IdField" "ledgerTypeID"
                            "TextField" "typeName"
                            "SelectedValue" ""
                            "SelectedText" ""
                            "MaxResults" 10
                            "Required" true
                            "EventTarget" "ledgerTypeID"
                        )}}
                        {{template "searchable-select" (map
                            "ID" "currency"
                            "Name" "currency"
                            "Label" "Currency"
                            "Placeholder" "Search a currency..."
                            "ApiUrl" (printf "/%s/api/currencies" .Username)
                            "IdField" "alphabeticCode"
                            "TextField" "currencyName"
                            "SelectedValue" ""
                            "SelectedText" ""
                            "MaxResults" 10
                            "Required" true
                            "EventTarget" "currency"
                        )}}
                        <div class="form-group">
                            <label for="balance">Balance</label>
                            <input
                                x-model="balance"
                                x-on:input="validateField($el)"
                                class="form-control"
                                id="balance"
                                name="balance"
                                required
                                autocomplete="off"
                                type="number"
                                min="0"
                                step="0.01"
                            >
                            <div class="invalid-feedback">Please enter a balance</div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-primary" @click="save">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
